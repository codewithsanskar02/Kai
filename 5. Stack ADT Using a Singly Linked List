#include <iostream>
using namespace std;
struct Node {
    int data;
    Node *next;
};
Node *topNode = NULL;
void push(int x) {
    Node *p = new Node;
    p->data = x;
    p->next = topNode;
    topNode = p;
}
void pop() {
    if (topNode == NULL) {
        cout << "Stack underflow.\n";
        return;
    }
    Node *p = topNode;
    cout << "Deleted: " << p->data << "\n";
    topNode = topNode->next;
    delete p;
}
void display() {
    if (topNode == NULL) { cout << "Stack is empty.\n"; return; }
    Node *p = topNode;
    while (p != NULL) { cout << p->data << " "; p = p->next; }
    cout << "\n";
}
int main() {
    int choice, x;
    do {
        cout << "1.Push 2.Pop 3.Display 0.Exit: ";
        cin >> choice;
        if (choice == 1) { cout << "Value: "; cin >> x; push(x); }
        else if (choice == 2) pop();
        else if (choice == 3) display();
    } while (choice != 0);
    while (topNode != NULL) { Node *p = topNode; topNode = topNode->next; delete p; }
    return 0;
}