#include <iostream>
#include <string>
using namespace std;
char st[200];
int top = -1;
void push(char c) { st[++top] = c; }
char pop() { return st[top--]; }
char peek() { return st[top]; }
int precedence(char c) {
    if (c == '^') return 3;
    if (c == '*' || c == '/') return 2;
    if (c == '+' || c == '-') return 1;
    return 0;
}
int main() {
    string infix, postfix = "";
    cout << "Enter infix expression (single-letter/digit operands): ";
    cin >> infix;
    for (int i = 0; i < (int)infix.length(); i++) {
        char c = infix[i];
        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
            (c >= '0' && c <= '9')) postfix += c;
        else if (c == '(') push(c);
        else if (c == ')') {
            while (top != -1 && peek() != '(') postfix += pop();
            if (top != -1) pop();
        } else {
            while (top != -1 && peek() != '(' &&
                   (precedence(peek()) > precedence(c) ||
                   (precedence(peek()) == precedence(c) && c != '^')))
                postfix += pop();
            push(c);
        }
    }
    while (top != -1) postfix += pop();
    cout << "Postfix: " << postfix << "\n";
    return 0;
}