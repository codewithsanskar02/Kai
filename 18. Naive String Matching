text = input("Enter text: ")
pattern = input("Enter pattern: ")
n = len(text)
m = len(pattern)
positions = []
if m <= n:
    for i in range(n - m + 1):
        j = 0
        while j < m and text[i + j] == pattern[j]:
            j += 1
        if j == m:
            positions.append(i)
print("Matching starting indices:", positions)