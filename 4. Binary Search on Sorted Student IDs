#include <iostream>
using namespace std;
int main() {
    int n, a[100], key;
    cout << "Enter number of IDs (1-100): ";
    cin >> n;
    if (n < 1 || n > 100) return 0;
    cout << "Enter IDs: ";
    for (int i = 0; i < n; i++) cin >> a[i];
    // Sort IDs first using bubble sort
    for (int i = 0; i < n - 1; i++)
        for (int j = 0; j < n - i - 1; j++)
            if (a[j] > a[j + 1]) {
                int t = a[j]; a[j] = a[j + 1]; a[j + 1] = t;
            }
    cout << "Sorted IDs: ";
    for (int i = 0; i < n; i++) cout << a[i] << " ";
    cout << "\nEnter ID to search: ";
    cin >> key;
    int low = 0, high = n - 1, found = 0;
    while (low <= high) {
        int mid = (low + high) / 2;
        if (a[mid] == key) { found = 1; break; }
        else if (a[mid] < key) low = mid + 1;
        else high = mid - 1;
    }
    if (found) cout << "ID is present.\n";
    else cout << "ID is not present.\n";
    return 0;
}